# Copy to .env and replace the placeholder secrets before use.
# These values are for LOCAL DEVELOPMENT ONLY and are not production credentials.

NODE_ENV=development
PORT=3000

# Docker Compose uses POSTGRES_* to initialise the database on first run.
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_DB=helpdesk_pro

DATABASE_URL=postgres://helpdesk:local_dev_change_me@localhost:5432/helpdesk_pro
TEST_DATABASE_URL=postgres://helpdesk:local_dev_change_me@localhost:5432/helpdesk_pro_test

# Least-privileged role used by the production API. The migrate service creates
# and grants this role; replace the password before production use.
APP_DATABASE_USER=helpdesk_app
APP_DATABASE_PASSWORD=local_dev_change_me

# Replace with a unique long random value. Production startup rejects example values.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d

# Set only when running behind a trusted reverse proxy. Number of proxies to trust.
# TRUST_PROXY_HOPS=1

UPLOAD_DIR=./uploads
# Vercel Functions accept at most 4.5 MB by default; env.js uses 4 MiB there.
# The 20 MB body limit is a separate beta opt-in that must be enabled first.
MAX_UPLOAD_BYTES=5242880
TICKET_UPLOAD_QUOTA_BYTES=52428800
USER_UPLOAD_QUOTA_BYTES=104857600

# Vercel-only settings. Keep secrets in the Vercel dashboard, not in this file.
# VERCEL_ENV=preview
# DATABASE_POOL_MAX=1
# CRON_SECRET=replace_with_a_random_secret_at_least_32_chars
# ATTACHMENT_STORAGE=blob
# BLOB_READ_WRITE_TOKEN=replace_with_your_vercel_blob_token

# Public origin used in password-reset and verification email links.
# docker-compose.prod.yml requires this to be set explicitly; use the public HTTPS origin.
APP_BASE_URL=http://127.0.0.1:5173
REQUIRE_EMAIL_VERIFICATION=false
PASSWORD_RESET_TTL=1h
EMAIL_VERIFICATION_TTL=24h

# Shared rate limits. Leave REDIS_URL unset to use the in-memory store locally.
# Vercel requires REDIS_URL because each function instance has its own memory.
# REDIS_PASSWORD is required by docker-compose.prod.yml; replace it before production use.
REDIS_PASSWORD=local_dev_change_me
# REDIS_URL=redis://localhost:6379

# Single-container deployments (for example Render) should set both flags to
# true so migrations and idempotent reference data finish before Express listens.
# Startup seeding never creates bootstrap admin/agent/employee or demo users.
RUN_MIGRATIONS_ON_START=false
SEED_REFERENCE_DATA_ON_START=false

# Retention of append-only audit and ticket-history rows.
RETENTION_ENABLED=false
AUDIT_RETENTION_DAYS=365
TICKET_HISTORY_RETENTION_DAYS=365
RETENTION_INTERVAL_MS=86400000

# ClamAV INSTREAM scanning. AV_ENABLED=true fails closed and requires CLAMAV_HOST.
# Vercel requires both; CLAMAV_HOST must point to a network-reachable scanner.
AV_ENABLED=false
# CLAMAV_HOST=clamd
# CLAMAV_PORT=3310
# AV_SCAN_TIMEOUT_MS=5000
# AV_QUARANTINE_DIR=./quarantine

# Optional SMTP settings for Phase 5 email notifications. Without SMTP_HOST and
# SMTP_FROM, notification events are logged but no email is delivered.
# NOTIFICATIONS_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=helpdesk@example.com
# SMTP_PASSWORD=replace_with_a_real_password
# SMTP_FROM=HelpDesk Pro <helpdesk@example.com>

# Optional Vite web settings. VITE_API_PROXY_TARGET controls dev/preview proxying;
# VITE_API_BASE_URL controls the prefix used by the browser API client.
# VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# VITE_API_BASE_URL=/api

# Optional bootstrap accounts used by `npm run seed`.
SEED_ADMIN_EMAIL=admin@helpdesk.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_AGENT_EMAIL=agent@helpdesk.local
SEED_AGENT_PASSWORD=ChangeMe123!
SEED_EMPLOYEE_EMAIL=employee@helpdesk.local
SEED_EMPLOYEE_PASSWORD=ChangeMe123!

# Optional password for `npm run seed:demo` accounts.
SEED_DEMO_PASSWORD=Demo12345!

# Bootstrap and demo data are never created in production unless each is
# explicitly enabled. Leave them unset when deploying with real credentials.
# ALLOW_PRODUCTION_BOOTSTRAP_USERS=false
# ALLOW_PRODUCTION_DEMO_DATA=false
